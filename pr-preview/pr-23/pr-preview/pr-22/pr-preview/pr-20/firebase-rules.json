{
  "rules": {
    "players": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['id', 'name', 'position', 'lastSyncedAt'])"
      }
    },
    "pendingHits": {
      "$targetUid": {
        ".read": "auth != null && auth.uid === $targetUid",
        "$hitId": {
          ".write": "auth != null && (auth.uid === $targetUid || (!data.exists() && newData.exists() && newData.child('casterId').val() === auth.uid))",
          ".validate": "newData.hasChildren(['casterId', 'spellId', 'impactAt'])"
        }
      }
    }
  }
}
